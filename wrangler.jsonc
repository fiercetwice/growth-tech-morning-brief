{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growth-tech-morning-brief",
  "main": "src/index.js",
  "compatibility_date": "2026-08-03",
  "triggers": {
    "crons": ["35 13 * * 1-5", "35 14 * * 1-5"]
  },
  "vars": {
    "WATCHLIST": "NVDA,AMZN,MSFT,ANET,CRWV,AVGO,META,GOOGL,ORCL,TSM,VRT,CEG,FTNT",
    "DISCOVERY_ENABLED": "true",
    "DISCOVERY_LIMIT": "6",
    "DISCOVERY_MIN_MARKET_CAP": "250000000",
    "DISCOVERY_MIN_DOLLAR_VOLUME": "5000000",
    "SEC_REFRESH_LIMIT": "2",
    "REPORT_MODE": "verbose",
    "RESEARCH_BATCH_SIZE": "3",
    "RESEARCH_MAX_TOKENS": "4000",
    "AI_VERBOSE_MAX_TOKENS": "24000",
    "AI_STANDARD_MAX_TOKENS": "12000",
    "RUN_TOKEN_REQUIRED": "true"
  },
  "r2_buckets": [{ "binding": "BRIEF_BUCKET", "bucket_name": "growth-tech-brief-data" }]
}
